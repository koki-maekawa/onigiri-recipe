<div class="flex flex-col w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 gap-6">
  <div class="text-center">
    <%= link_to user_path(@user),
          class: "inline-block text-xl sm:text-2xl md:text-3xl font-bold text-gray-900 hover:text-green-600 transition-colors duration-200" do %>
      <%= @user.name %>
    <% end %>
  </div>
  <div class="w-full">
    <div class="mb-6">
      <h2 class="text-lg sm:text-xl md:text-2xl font-bold text-gray-900 border-b-2 border-blue-500 pb-2">
        <%= t("defaults.bookmarked_recipe") %>
      </h2>
    </div>
    <%= turbo_frame_tag "rice-balls-list", class: "w-full space-y-6" do %>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        <% @bookmarked_rice_balls.each do |rice_ball| %>
          <%= render "rice_balls/rice_ball", rice_ball: rice_ball, user: rice_ball.user %>
        <% end %>
      </div>
      <div class="flex justify-center mt-8">
        <%= paginate @bookmarked_rice_balls %>
      </div>
    <% end %>
  </div>
</div>
