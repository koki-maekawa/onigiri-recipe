<% if user_signed_in? %>
  <% bookmarked = current_user.already_bookmarked?(rice_ball) %>
  <% case size %>
  <% when "index" %>
    <% if current_user != rice_ball.user %>
      <div id="<%= dom_id(rice_ball, :bookmark) %>">
        <%= link_to rice_ball_bookmarks_path(rice_ball, size: :index),
                  data: { turbo_method: bookmarked ? :delete : :post } do %>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-6 h-6 <%= bookmarked ? 'fill-current text-gray-900' : 'fill-none' %> stroke-current text-gray-600 hover:text-gray-900 transition-colors duration-200">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
          </svg>
        <% end %>
      </div>
    <% end %>
  <% when "show" %>
    <% if current_user != rice_ball.user %>
      <div id="<%= dom_id(rice_ball, :bookmark) %>">
        <%= link_to rice_ball_bookmarks_path(rice_ball, size: :show),
                  data: { turbo_method: bookmarked ? :delete : :post },
                  class: "flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500 transition duration-200 md:px-6 md:py-3 md:text-base" do %>
          <span><%= bookmarked ? t("defaults.bookmarked") : t("defaults.bookmark") %></span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-5 h-5 md:w-6 md:h-6 <%= bookmarked ? 'fill-current text-gray-900' : 'fill-none' %> stroke-current text-gray-600">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
          </svg>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
